[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/Settings/Control/ScrollContainer/VBoxContainer" unique_id=408315159]
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
bbcode_enabled = true
text = "[font_size=25][outline_size=10][color=aqua]Bounciness: The maximum angle the ball can make with the paddle surface once they collide, the closer you are the the edge of the paddle the closer the angle will be to the max angle."

[node name="RichTextLabel2" type="RichTextLabel" parent="CanvasLayer/Settings/Control/ScrollContainer/VBoxContainer" unique_id=1680888203]
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
bbcode_enabled = true
text = "[font_size=25][outline_size=10][color=aqua]Max Speed: When a ball hits a paddle it becomes faster, this number is the maximum amount of speed the ball can reach, being 400 the initial speed."

[node name="RichTextLabel3" type="RichTextLabel" parent="CanvasLayer/Settings/Control/ScrollContainer/VBoxContainer" unique_id=692378714]
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
bbcode_enabled = true
text = "[font_size=25][outline_size=10][color=aqua]Speed increase %: it's the factor by which the current speed is multiplied to calculate the next speed. This factor is applied every time the ball hits the paddle until it reaches the Max Speed."

[node name="RichTextLabel4" type="RichTextLabel" parent="CanvasLayer/Settings/Control/ScrollContainer/VBoxContainer" unique_id=148109881]
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
bbcode_enabled = true
text = "[font_size=25][outline_size=10][color=aqua]Show Controls: Controls are shown on top of the players if it's activated, it might be helpful to see controls at first, but it's better to turn them off afterwards."

[node name="RichTextLabel5" type="RichTextLabel" parent="CanvasLayer/Settings/Control/ScrollContainer/VBoxContainer" unique_id=2000680077]
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
bbcode_enabled = true
text = "[font_size=25][outline_size=10][color=aqua]Weight: The odds of a ball appearing, they can sum up to any number, the larger the weight is compared to the others the more odds it has to appear"

