[node name="Frame3" parent="CanvasLayer/Balls/Control/ScrollContainer/GridContainer" unique_id=1771007981 instance=ExtResource("4_qht1w")]
layout_mode = 2
DisplayObjectScene = ExtResource("5_w4qjf")
text = "This ball starts being a normal ball, but once it bounces for first time it's speed becomes the maximum, if it's a player in this state the hit player recives -2 points, and its value points become 0."
TittleText = "Fire Ball"

[node name="Frame4" parent="CanvasLayer/Balls/Control/ScrollContainer/GridContainer" unique_id=1920996310 instance=ExtResource("4_qht1w")]
layout_mode = 2
DisplayObjectScene = ExtResource("7_y34m4")
text = "It accelerates twice as fast and has a higher initial velocity"
TittleText = "Fast Ball"

[node name="Frame5" parent="CanvasLayer/Balls/Control/ScrollContainer/GridContainer" unique_id=1425910344 instance=ExtResource("4_qht1w")]
layout_mode = 2
